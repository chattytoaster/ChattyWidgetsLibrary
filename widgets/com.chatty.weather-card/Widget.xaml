<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChattyWidgets.UI.Controls;assembly=ChattyWidgets"
        Background="#D0121622"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="16,14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- City Pill -->
            <Border DockPanel.Dock="Left" Background="#1838BDF8" BorderBrush="#3538BDF8" BorderThickness="1"
                    CornerRadius="16" Padding="10,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📍 " FontSize="12" VerticalAlignment="Center"/>
                    <controls:MarqueeText Text="{Binding City}" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8"
                                          VerticalAlignment="Center" MaxWidth="120"/>
                </StackPanel>
            </Border>

            <!-- Update Time -->
            <TextBlock Text="{Binding UpdateTime}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"
                       DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Main Weather Row -->
        <Grid Grid.Row="1" Margin="0,2,0,8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Temperature & Condition -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Temperature}" FontSize="44" FontWeight="Bold" Foreground="#F8FAFC"/>
                <controls:MarqueeText Text="{Binding Condition}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"
                                      Margin="0,2,0,2" MaxWidth="160"/>
                <TextBlock Text="{Binding FeelsLike}" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Hero Weather Icon with Glow -->
            <TextBlock Grid.Column="1" Text="{Binding WeatherIcon}" FontSize="50" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Color="#38BDF8" Opacity="0.45"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- Bottom 4-Column Metrics Bar -->
        <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <UniformGrid Columns="4">
                <!-- Wind -->
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="4,5" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WindLabel, FallbackValue='ВЕТЕР'}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WindSpeed}" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Humidity -->
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="4,5" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding HumidityLabel, FallbackValue='ВЛАЖНОСТЬ'}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Humidity}" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pressure -->
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="4,5" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PressureLabel, FallbackValue='ДАВЛЕНИЕ'}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Pressure}" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Min/Max -->
                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="4,5" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MinMaxLabel, FallbackValue='МИН / МАКС'}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MinMax}" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>
    </Grid>
</Border>
