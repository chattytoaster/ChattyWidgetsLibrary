<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="📍 " FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding City}" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="LIVE" FontWeight="Bold" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Main Temp & Icon -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding WeatherIcon}" FontSize="36" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Temperature}" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="{Binding Condition}" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>
        </DockPanel>

        <!-- Details Bar -->
        <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💧 Влажность" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Humidity}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💨 Ветер" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding WindSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏱ Давление" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Pressure}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Forecast Row -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Forecast}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#10FFFFFF" CornerRadius="8" Margin="2,0" Padding="4,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DayName}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Temp}" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Border>
