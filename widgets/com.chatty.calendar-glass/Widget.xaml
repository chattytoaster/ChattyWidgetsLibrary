<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="📅 " FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MonthYear}" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Command="{Binding PrevMonthCommand}" Content="◀" Width="24" Height="24" Margin="2,0"
                        Background="#20FFFFFF" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Command="{Binding TodayCommand}" Content="•" Width="24" Height="24" Margin="2,0"
                        Background="#20FFFFFF" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" ToolTip="Сегодня">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Command="{Binding NextMonthCommand}" Content="▶" Width="24" Height="24" Margin="2,0"
                        Background="#20FFFFFF" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Subtitle: Today -->
        <TextBlock Grid.Row="1" Text="{Binding TodayFull}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

        <!-- Weekdays Header -->
        <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="ПН" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="ВТ" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="СР" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="ЧТ" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="ПТ" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="СБ" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="ВС" Foreground="#F43F5E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </UniformGrid>

        <!-- Month Days Grid -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BgColor}" CornerRadius="6" Margin="2" Height="28">
                        <TextBlock Text="{Binding DayText}" Foreground="{Binding FgColor}" FontWeight="{Binding Weight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Border>
