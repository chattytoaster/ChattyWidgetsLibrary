<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="14,16,14,12">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding MonthYear}" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"
                       LetterSpacing="0.3" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Command="{Binding PrevMonthCommand}" Content="◀" Width="26" Height="26" Background="#14FFFFFF"
                        BorderBrush="#18FFFFFF" BorderThickness="1" Foreground="#E2E8F0" FontSize="10" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="13"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Command="{Binding TodayCommand}" Content="Сегодня" Background="#266366F1" BorderBrush="#506366F1"
                        BorderThickness="1" Foreground="#818CF8" FontSize="10.5" FontWeight="SemiBold" Padding="8,3"
                        Margin="4,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Command="{Binding NextMonthCommand}" Content="▶" Width="26" Height="26" Background="#14FFFFFF"
                        BorderBrush="#18FFFFFF" BorderThickness="1" Foreground="#E2E8F0" FontSize="10" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="13"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Weekdays Header Row -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="Пн" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Вт" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Ср" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Чт" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Пт" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Text="Сб" FontSize="11" FontWeight="SemiBold" Foreground="#FDA4AF" HorizontalAlignment="Center"/>
            <TextBlock Text="Вс" FontSize="11" FontWeight="SemiBold" Foreground="#FDA4AF" HorizontalAlignment="Center"/>
        </UniformGrid>

        <!-- Days Grid -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="1.5" Height="26" CornerRadius="13" Background="{Binding BgColor}">
                        <TextBlock Text="{Binding DayText}" FontSize="11" FontWeight="{Binding Weight}"
                                   Foreground="{Binding FgColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer / Today Status -->
        <Border Grid.Row="3" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <DockPanel>
                <TextBlock Text="📅 Сегодня:" FontSize="10.5" Foreground="#64748B" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding TodayFull}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"
                           HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Border>
