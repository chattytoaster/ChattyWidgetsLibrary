<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D8121622"
        BorderBrush="#20FFFFFF"
        BorderThickness="1"
        CornerRadius="18"
        Padding="16,18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <!-- Left: Icon + Title Group -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="🎮" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GPU ENGINE" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding GpuName}" FontSize="10" Foreground="#94A3B8" MaxWidth="170"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Temp Badge -->
            <Border HorizontalAlignment="Right" DockPanel.Dock="Right" Background="#26EF4444" BorderBrush="#40EF4444"
                    BorderThickness="1" CornerRadius="8" Padding="7,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔥 " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:0}°C'}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#F87171" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Metrics Grid (Side-by-side 2 Columns) -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Box 1: Core GPU Load -->
            <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ЗАГРУЗКА" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                        <TextBlock Text="%" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding GpuPercent, StringFormat='{}{0:0}%'}" FontSize="18" FontWeight="Bold"
                               Foreground="#10B981" Margin="0,4,0,6"/>
                    <ProgressBar Grid.Row="2" Value="{Binding GpuPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="5"
                                 Background="#14FFFFFF" BorderThickness="0">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#10B981" Offset="0.0"/>
                                <GradientStop Color="#34D399" Offset="1.0"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </Grid>
            </Border>

            <!-- Box 2: VRAM Load -->
            <Border Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="ВИДЕОПАМЯТЬ" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding GpuMemoryPercent, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding GpuMemoryPercent, StringFormat='{}{0:0}%'}" FontSize="18" FontWeight="Bold"
                               Foreground="#38BDF8" Margin="0,4,0,6"/>
                    <ProgressBar Grid.Row="2" Value="{Binding GpuMemoryPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="5"
                                 Background="#14FFFFFF" BorderThickness="0">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Info -->
        <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <DockPanel>
                <TextBlock Text="DirectX / DWM Hardware" FontSize="10" Foreground="#64748B" DockPanel.Dock="Left"/>
                <TextBlock Text="Память активна" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Border>
