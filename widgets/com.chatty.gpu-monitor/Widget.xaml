<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🎮 GPU МОНИТОР" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left"/>
            <TextBlock Text="LIVE" FontWeight="Bold" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- GPU Device Name -->
        <TextBlock Grid.Row="1" Text="{Binding GpuName}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

        <!-- Core GPU Load -->
        <Grid Grid.Row="2" Margin="0,3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="Загрузка чипа (GPU)" FontSize="12" Foreground="#CBD5E1"/>
                <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
            </DockPanel>
            <ProgressBar Grid.Row="1" Value="{Binding GpuPercent}" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,0"
                         Foreground="#10B981" Background="#2010B981" BorderThickness="0"/>
        </Grid>

        <!-- VRAM Load -->
        <Grid Grid.Row="3" Margin="0,3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="Видеопамять (VRAM)" FontSize="12" Foreground="#CBD5E1"/>
                <TextBlock Text="{Binding GpuMemoryPercent, StringFormat='{}{0:0}%'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
            </DockPanel>
            <ProgressBar Grid.Row="1" Value="{Binding GpuMemoryPercent}" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,0"
                         Foreground="#F59E0B" Background="#20F59E0B" BorderThickness="0"/>
        </Grid>

        <!-- Temp & Stats -->
        <Border Grid.Row="4" Margin="0,10,0,0" Background="#18FFFFFF" CornerRadius="8" Padding="10,6">
            <DockPanel>
                <TextBlock Text="Температура" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:0} °C'}" FontWeight="Bold" FontSize="12" Foreground="#EC4899"
                           HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Border>
