<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D80E121E"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="14,16">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- Title -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="📰 " FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FeedTitle}" FontSize="11.5" FontWeight="ExtraBold" Foreground="#F8FAFC"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Pager Controls -->
            <Border HorizontalAlignment="Right" DockPanel.Dock="Right" Background="#10FFFFFF" BorderBrush="#18FFFFFF"
                    BorderThickness="1" CornerRadius="12" Padding="4,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PrevSlideCommand}" Content="◀" Width="20" Height="20" Background="Transparent"
                            Foreground="#94A3B8" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="{Binding CounterText}" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding NextSlideCommand}" Content="▶" Width="20" Height="20" Background="Transparent"
                            Foreground="#94A3B8" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                    <Button Command="{Binding RefreshCommand}" Content="⟳" Width="20" Height="20" Background="Transparent"
                            Foreground="#38BDF8" FontSize="11" BorderThickness="0" Margin="2,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Featured News Slide Card -->
        <Border Grid.Row="1" CornerRadius="14" BorderBrush="#4038BDF8" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B01E293B" Offset="0.0"/>
                    <GradientStop Color="#D00F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Badge Row -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0.0"/>
                                <GradientStop Color="#2563EB" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding CurrentArticle.Source}" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentArticle.Time}" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,6,0"/>
                        <Ellipse Width="6" Height="6" Fill="#10B981"/>
                    </StackPanel>
                </DockPanel>

                <!-- Headline -->
                <TextBlock Grid.Row="1" Text="{Binding CurrentArticle.Title}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"
                           TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,6"/>

                <!-- Open Link button -->
                <Button Grid.Row="2" Command="{Binding CurrentArticle.OpenCommand}" Content="Читать в источнике →"
                        HorizontalAlignment="Left" Background="Transparent" Foreground="#38BDF8" FontSize="10.5"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Sub-header -->
        <TextBlock Grid.Row="2" Text="ВСЕ НОВОСТИ:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>

        <!-- Feed List Items -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Articles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Source}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Time}" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" Foreground="#E2E8F0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Border>
