<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChattyWidgets.UI.Controls;assembly=ChattyWidgets"
        Background="#D80E121E"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="14,12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <!-- Title -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="📰 " FontSize="13" VerticalAlignment="Center"/>
                <controls:MarqueeText Text="{Binding FeedTitle}" FontSize="11.5" FontWeight="ExtraBold" Foreground="{Binding FeedTitleColor}"
                                      VerticalAlignment="Center" MaxWidth="160"/>
            </StackPanel>

            <!-- Pager Controls -->
            <Border HorizontalAlignment="Right" DockPanel.Dock="Right" Background="{Binding PagerBackground}" BorderBrush="{Binding PagerBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="4,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PrevSlideCommand}" Content="◀" Width="20" Height="20" Background="Transparent"
                            Foreground="{Binding PagerButtonForeground}" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="{Binding CounterText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding PagerCounterColor}" Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding NextSlideCommand}" Content="▶" Width="20" Height="20" Background="Transparent"
                            Foreground="{Binding PagerButtonForeground}" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                    <Button Command="{Binding RefreshCommand}" Content="⟳" Width="20" Height="20" Background="Transparent"
                            Foreground="{Binding PagerRefreshForeground}" FontSize="11" BorderThickness="0" Margin="2,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Featured News Slide Card -->
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="{Binding FeaturedCardBorderBrush}" BorderThickness="1"
                Background="{Binding FeaturedCardBackground}" Padding="10,7" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Badge Row -->
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0.0"/>
                                <GradientStop Color="#2563EB" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding CurrentArticle.Source}" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentArticle.Time}" FontSize="10.5" Foreground="{Binding FeaturedTimeColor}" Margin="0,0,6,0"/>
                        <Ellipse Width="6" Height="6" Fill="#10B981"/>
                    </StackPanel>
                </DockPanel>

                <!-- Headline -->
                <TextBlock Grid.Row="1" Text="{Binding CurrentArticle.Title}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding FeaturedHeadlineColor}"
                           TextWrapping="Wrap" LineHeight="16" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                <!-- Open Link button -->
                <Button Grid.Row="2" Command="{Binding CurrentArticle.OpenCommand}" Content="Читать в источнике →"
                        HorizontalAlignment="Left" Background="Transparent" Foreground="{Binding FeaturedLinkColor}" FontSize="10"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Sub-header -->
        <TextBlock Grid.Row="2" Text="ВСЕ НОВОСТИ:" FontSize="9.5" FontWeight="Bold" Foreground="{Binding SubheaderColor}" Margin="0,0,0,4"/>

        <!-- Feed List Items -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Articles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="1" CornerRadius="8"
                                Padding="8,5" Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Source}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding SourceColor}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Time}" FontSize="9.5" Foreground="{Binding TimeColor}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <controls:MarqueeText Grid.Row="1" Text="{Binding Title}" FontSize="11" Foreground="{Binding TitleColor}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Border>
