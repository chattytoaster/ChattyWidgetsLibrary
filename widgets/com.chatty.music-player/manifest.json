{
  "id": "com.chatty.music-player",
  "name": "Мини-Медиаплеер",
  "version": "1.0.0",
  "author": "ChattyWidgets",
  "description": "Стильный настольный контроллер для Spotify, Яндекс.Музыки, браузера и системных аудиоплееров.",
  "type": "web",
  "entry": "index.html",
  "icon": "icon.png",
  "defaultWidth": 340,
  "defaultHeight": 130,
  "minWidth": 260,
  "minHeight": 110,
  "resizable": true,
  "defaultLayer": "desktop",
  "clickThrough": false,
  "permissions": ["media"],
  "menuItems": [
    { "id": "toggle-art-style", "title": "Сменить стиль пластинки" },
    { "id": "refresh-media", "title": "Обновить информацию о треке" }
  ]
}
