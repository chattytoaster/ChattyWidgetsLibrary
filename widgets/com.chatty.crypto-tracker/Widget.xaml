<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChattyWidgets.UI.Controls;assembly=ChattyWidgets"
        Background="#D8121622"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="14,16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderTitle, FallbackValue='💎 КОТИРОВКИ &amp; ВАЛЮТЫ'}" FontSize="11.5" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <Border Background="#1CFFFFFF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BaseCurrencyBadge, FallbackValue='USD'}" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                </Border>
            </StackPanel>
            <Border HorizontalAlignment="Right" DockPanel.Dock="Right" Background="#14FFFFFF" BorderBrush="#18FFFFFF"
                    BorderThickness="1" CornerRadius="6" Padding="8,3" Cursor="Hand" ToolTip="{Binding LastUpdatedText}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding RefreshCommand}"/>
                </Border.InputBindings>
                <TextBlock Text="{Binding RefreshButtonText, FallbackValue='Обновить ↻'}" FontSize="11" Foreground="#94A3B8"/>
            </Border>
        </DockPanel>

        <!-- Rates List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="10,6" Margin="0,0,0,5">
                            <DockPanel>
                                <!-- Left: Icon + Symbol + Name -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="13" Foreground="#F8FAFC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" controls:MarqueeBehavior.EnableMarquee="True"/>
                                </StackPanel>

                                <!-- Right: Price + Change Badge -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Price}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Background="{Binding ChangeColor, Converter={x:Null}}">
                                        <TextBlock Text="{Binding Change}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Border>
