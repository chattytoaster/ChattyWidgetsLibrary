<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📊 РЫНКИ &amp; ВАЛЮТЫ" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left"/>
            <TextBlock Text="LIVE" FontWeight="Bold" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Crypto Items List -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#10FFFFFF" CornerRadius="10" Margin="0,3" Padding="10,6">
                        <DockPanel>
                            <!-- Icon -->
                            <Border Width="26" Height="26" Background="#20FFFFFF" CornerRadius="13" Margin="0,0,10,0" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Icon}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name & Symbol -->
                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock Text="{Binding Symbol}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Price & Change -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding Price}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Change}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ChangeColor}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Border>
