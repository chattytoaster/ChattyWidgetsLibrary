<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D8121622"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        ClipToBounds="True">
    <Grid x:Name="MediaGrid" Background="Transparent">
        <Grid.OpacityMask>
            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                <VisualBrush.Visual>
                    <Border Background="Black" CornerRadius="19"
                            Width="{Binding ActualWidth, ElementName=MediaGrid}"
                            Height="{Binding ActualHeight, ElementName=MediaGrid}"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.OpacityMask>
        <!-- Blurred background image for letterbox / contain mode -->
        <Image Source="{Binding CurrentImage}"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="{Binding BlurredBackdropOpacity}"
               Visibility="{Binding ImageVisibility}">
            <Image.Effect>
                <BlurEffect Radius="24"/>
            </Image.Effect>
        </Image>

        <!-- Main Image View -->
        <Image Source="{Binding CurrentImage}"
               Stretch="{Binding StretchMode}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="{Binding PhotoOpacity}"
               Visibility="{Binding ImageVisibility}"/>

        <!-- Placeholder when empty -->
        <Border Background="#C0101420" Opacity="{Binding PhotoOpacity}" Padding="16" CornerRadius="19"
                Visibility="{Binding PlaceholderVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#38BDF8" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding DragDropHintText, FallbackValue='Перетащите сюда фото или папку'}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding DragDropSubText, FallbackValue='или укажите папку в настройках (ПКМ)'}" FontSize="11" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="JPG" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="PNG" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="WEBP" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="BMP" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="GIF" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Controls Bar (hideable on hover / configurable) -->
        <Border VerticalAlignment="Bottom" Background="#80000000" CornerRadius="0,0,19,19" Padding="8,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <!-- When AutoHideControls is True, animate Opacity on hover -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding AutoHideControls}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- When AutoHideControls is False, controls remain always visible -->
                        <DataTrigger Binding="{Binding AutoHideControls}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="{Binding Caption}" FontSize="10.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"
                            Visibility="{Binding NavigationButtonsVisibility}">
                    <Button Command="{Binding PrevCommand}" ToolTip="{Binding PrevTooltip}" Content="◀" Width="22" Height="22" Background="#20FFFFFF"
                            Foreground="#FFFFFF" FontSize="9" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Command="{Binding NextCommand}" ToolTip="{Binding NextTooltip}" Content="▶" Width="22" Height="22" Background="#20FFFFFF"
                            Foreground="#FFFFFF" FontSize="9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Border>