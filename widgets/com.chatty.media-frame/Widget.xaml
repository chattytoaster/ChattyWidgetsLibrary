<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D8121622"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        ClipToBounds="True">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <!-- Image View -->
        <Image Source="{Binding CurrentImage}" Stretch="UniformToFill" Visibility="{Binding ImageVisibility}"/>

        <!-- Placeholder when empty -->
        <Border Background="#C0101420" Padding="16"
                Visibility="{Binding PlaceholderVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#38BDF8" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Перетащите сюда фото или видео" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="или нажмите ПКМ для выбора файла" FontSize="11" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="JPG" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="PNG" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="GIF" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="6,2" Margin="2,0">
                        <TextBlock Text="MP4" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Controls Bar -->
        <Border VerticalAlignment="Bottom" Background="#80000000" Padding="8,4">
            <DockPanel>
                <TextBlock Text="{Binding Caption}" FontSize="10.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Command="{Binding PrevCommand}" Content="◀" Width="22" Height="22" Background="#20FFFFFF"
                            Foreground="#FFFFFF" FontSize="9" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Command="{Binding NextCommand}" Content="▶" Width="22" Height="22" Background="#20FFFFFF"
                            Foreground="#FFFFFF" FontSize="9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Border>
