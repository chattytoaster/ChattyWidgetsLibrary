<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="12">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Picture Display with rounded clip -->
        <Border Grid.Row="0" CornerRadius="14" Background="#18FFFFFF" ClipToBounds="True">
            <Grid>
                <!-- Placeholder if no image -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="Папка «Изображения»" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <!-- Image -->
                <Image Source="{Binding CurrentImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bottom Controls & Caption -->
        <DockPanel Grid.Row="1" Margin="4,8,4,0">
            <Button Command="{Binding PrevCommand}" Content="◀" Width="26" Height="26"
                    Background="#20FFFFFF" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Command="{Binding NextCommand}" Content="▶" Width="26" Height="26"
                    Background="#20FFFFFF" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
        </DockPanel>
    </Grid>
</Border>
