<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0161A26"
        BorderThickness="0"
        CornerRadius="20"
        Padding="16">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="📝 " FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="БЫСТРЫЕ ЗАМЕТКИ" FontWeight="Bold" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Command="{Binding ClearCommand}" Content="Очистить" Width="64" Height="22"
                    Background="#18FFFFFF" Foreground="#94A3B8" FontSize="10" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Editable Note Area -->
        <Border Grid.Row="1" Background="#10FFFFFF" CornerRadius="10" Padding="10">
            <TextBox Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                     Foreground="#F1F5F9" CaretBrush="#FBBF24" FontSize="12" FontFamily="Segoe UI, sans-serif"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Border>
    </Grid>
</Border>
