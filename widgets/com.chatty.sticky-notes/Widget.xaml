<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D8181A26"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        CornerRadius="20"
        Padding="16">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📌 ЗАМЕТКИ И ЗАДАЧИ" FontSize="13" FontWeight="Bold" Foreground="#FBBF24"
                       LetterSpacing="0.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveCountText}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"
                       DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Input Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#12FFFFFF" Foreground="#F8FAFC" BorderBrush="#20FFFFFF" BorderThickness="1"
                     FontSize="12" Padding="8,6" VerticalAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Grid.Column="2" Command="{Binding AddTaskCommand}" Content="+" Width="34" Height="30"
                    Background="#FBBF24" Foreground="#1E293B" FontWeight="Bold" FontSize="15" BorderThickness="0"
                    Cursor="Hand" VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Tasks Checklist -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="8,6" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsDone}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Command="{Binding DeleteCommand}" Content="✕" DockPanel.Dock="Right" Background="Transparent"
                                        Foreground="#64748B" FontSize="11" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" TextDecorations="{Binding TextDecoration}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Border>
