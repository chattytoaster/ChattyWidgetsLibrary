<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D8181A26"
        BorderBrush="{Binding BorderAccentBrush}"
        BorderThickness="1"
        CornerRadius="20"
        Padding="16">
    <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="13" FontWeight="Bold" Foreground="{Binding HeaderBrush}"
                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Command="{Binding ClearCompletedCommand}" ToolTip="{Binding ClearCompletedTooltip}"
                        Content="✓" Width="24" Height="22" Background="{Binding AccentSoftBrush}"
                        Foreground="{Binding HeaderBrush}" FontSize="11" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="{Binding ActiveCountText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Input Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="120"
                         Background="#12FFFFFF" Foreground="#F8FAFC" BorderBrush="#20FFFFFF" BorderThickness="1"
                         FontSize="12" Padding="8,6,42,6" VerticalAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="{Binding PlaceholderText}" Foreground="#64748B" FontSize="12"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding PlaceholderVisibility}"/>
                <TextBlock Text="{Binding CounterBadgeText}" Foreground="#475569" FontSize="10"
                           HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <Button Grid.Column="2" Command="{Binding AddTaskCommand}" Content="+" Width="34" Height="30"
                    Background="{Binding AccentBrush}" Foreground="#0F172A" FontWeight="Bold" FontSize="15" BorderThickness="0"
                    Cursor="Hand" VerticalAlignment="Center" ToolTip="{Binding AddTaskTooltip}" IsEnabled="{Binding CanAddTask}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Tasks Checklist & Empty State -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="8"
                                    Padding="8,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding IsDone}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Command="{Binding DeleteCommand}" Content="✕" DockPanel.Dock="Right" Background="Transparent"
                                            Foreground="#64748B" FontSize="11" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" TextDecorations="{Binding TextDecoration}"
                                               FontSize="{Binding DataContext.NoteFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding EmptyStateText}" Foreground="#64748B" FontSize="11"
                       TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="16,24,16,16"
                       Visibility="{Binding EmptyStateVisibility}"/>
        </Grid>
    </Grid>
</Border>
