<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#D0121622"
        BorderThickness="0"
        CornerRadius="20"
        Padding="18">
    <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode & Reset Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button Command="{Binding SwitchModeCommand}" Content="{Binding ModeText}" Padding="8,3"
                    Background="#20FFFFFF" Foreground="{Binding AccentColor}" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Command="{Binding ResetCommand}" Content="↺ Сброс" Width="64" Height="24"
                    Background="#18FFFFFF" Foreground="#94A3B8" FontSize="11" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Huge Time Display -->
        <Viewbox Grid.Row="1" MaxHeight="80" Margin="0,8">
            <TextBlock Text="{Binding TimeText}" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
        </Viewbox>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,14"
                     Foreground="{Binding AccentColor}" Background="#20FFFFFF" BorderThickness="0"/>

        <!-- Action Button -->
        <Button Grid.Row="3" Command="{Binding ToggleTimerCommand}" Content="{Binding ActionButtonText}" Height="36"
                Background="{Binding AccentColor}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Border>
